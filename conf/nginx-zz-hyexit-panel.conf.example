# hyexit control panel - hidden entry on a non-standard port, TOTP gated.
# Everything outside the gateway returns a bare 404 to unauthenticated clients.
#
# Placeholders to replace:
#   <PANEL_PORT>  an obscure free port you pick yourself
#   <PANEL_HOST>  the panel hostname (must resolve to this server)
#   <CERT>, <KEY> your certificate paths
#
# Deploy with: deploy/03-install-panel.sh (it renders this file, tests nginx and auto-rolls back).

server {
    listen <PANEL_PORT> ssl;
    listen [::]:<PANEL_PORT> ssl;
    http2 on;
    server_name <PANEL_HOST>;

    ssl_certificate     <CERT>;
    ssl_certificate_key <KEY>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:HYEXIT:5m;
    ssl_session_timeout 1h;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    access_log /opt/hyexit/logs/panel-access.log;
    client_max_body_size 2m;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:19121;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # websockets (the UI streams logs/connections)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # the gateway answers OPTIONS itself; do not buffer streaming responses
        proxy_buffering off;
    }
}
