# /opt/hyexit/config/gen.env  --  chmod 600, NEVER commit.
#
# Site-specific values for gen-config.mjs, watchdog.sh, verify.sh and panel-cli.mjs.
# Syntax: KEY="value" (plain shell, sourced by the scripts). Anything omitted falls back to the
# documented placeholder default, so a missing value never breaks a script silently.

# --- routing ---------------------------------------------------------------
# Domains that must NEVER be proxied: your own sites, panel, upload point, mail, ...
HYEXIT_OWN_DOMAINS="example.com"

# Domains that must be proxied even when an upstream rule says DIRECT (usually empty).
HYEXIT_FORCE_PROXY_DOMAINS=""

# Extra upstream proxy-group names to treat as "PROXY" when merging subscription rules.
# Check the generator's "WARN dropped rules whose target group is not mapped" output and put the
# names it lists here -- a missing alias silently drops hundreds of rules (see docs/pitfalls.md #9).
HYEXIT_PROXY_ALIASES=""

# --- panel / verification --------------------------------------------------
# Where the hidden TOTP gateway lives (must match the nginx vhost and the systemd unit).
PANEL_HOST="panel.example.com"
PANEL_PORT=10443
HYEXIT_HOST="panel.example.com"
HYEXIT_PORT=10443

# Space-separated list of your own URLs; verify.sh expects HTTP 200 from each of them, which proves
# the host's own traffic still works while the proxy is running.
HYEXIT_SITES="example.com www.example.com"
