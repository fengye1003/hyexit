# /opt/hyexit/config/subs.env  --  chmod 600 root:root, NEVER commit.
#
# The generator only reads these three key names. Keep them exactly as below: if the keys and the
# generator's key list disagree you get "FATAL: no subscriptions in subs.env" (pitfalls.md #10).
#
# Any Clash/mihomo YAML subscription works. Order matters: provider1's rules are merged first, then
# provider3, then provider2 (priority is defined in gen-config.mjs, not by line order here).

provider1="https://your-primary-provider.example/api/v1/client/subscribe?token=REPLACE_ME"
provider2="https://your-second-provider.example/api/v1/client/subscribe?token=REPLACE_ME"
provider3="https://your-third-provider.example/api/v1/client/subscribe?token=REPLACE_ME"
